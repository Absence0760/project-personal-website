# Terraform working files — never committed.
.terraform/
*.tfstate
*.tfstate.backup
*.tfstate.lock.info
crash.log
crash.*.log

# Real tfvars may hold account-specific values — commit only the *.example.
*.tfvars
!*.tfvars.example
*.tfvars.local
.envrc.local

# This repo is PUBLIC and has NO backend/secrets (see CLAUDE.md). Production
# secrets for the estate live in the private Absence0760/infra-secrets repo
# (cloned at ../infra-secrets), one subdir per project. Guard against any
# decrypted scratch sneaking in here.
*.dec
*.dec.*
*.decrypted
*.decrypted.*
*.plain
*.plain.*
